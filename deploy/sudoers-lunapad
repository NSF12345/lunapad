# Template: install.sh fills in __USER__ (the lunapad account) and __APPDIR__
# (/opt/lunapad), checks it with visudo, and installs it as /etc/sudoers.d/lunapad.
# Lets the launcher reboot, run apt updates and update itself (self-update.sh, which
# is root-owned in __APPDIR__), and its login profile show the boot splash, without a
# password prompt - nothing else. Each is limited to those exact commands.
__USER__ ALL=(root) NOPASSWD: /usr/sbin/reboot, /usr/bin/apt-get update, /usr/bin/apt-get full-upgrade -y, /usr/bin/apt-get autoremove -y, /bin/bash __APPDIR__/deploy/self-update.sh stable, /bin/bash __APPDIR__/deploy/self-update.sh beta, /usr/bin/fbi -T 1 -noverbose -a __APPDIR__/splash.png
# sudo strips the environment; keep DEBIAN_FRONTEND so debconf never asks questions.
Defaults!/usr/bin/apt-get env_keep += "DEBIAN_FRONTEND"
